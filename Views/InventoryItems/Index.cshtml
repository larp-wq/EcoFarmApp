@model IEnumerable<EcoFarmApp.Models.InventoryItem>
@{
    ViewData["Title"] = "Склад";
}

<h1>Инвентарь и корма</h1>
<p><a asp-action="Create" class="btn btn-primary">Добавить на склад</a></p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ItemName)</th>
            <th>@Html.DisplayNameFor(model => model.Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.Unit)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.ItemName)</td>
            <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
            <td>@Html.DisplayFor(modelItem => item.Unit)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ItemID">Изменить</a> |
                <a asp-action="Delete" asp-route-id="@item.ItemID">Удалить</a>
            </td>
        </tr>
        }
    </tbody>
</table>