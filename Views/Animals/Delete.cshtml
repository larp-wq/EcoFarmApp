@model EcoFarmApp.Models.Animal
@{
    ViewData["Title"] = "Удаление животного";
}

<h1>Удалить</h1>
<h4>Вы уверены, что хотите удалить это животное?</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Species)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Species)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HealthStatus)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HealthStatus)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LastVaccination)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastVaccination)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AnimalID" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Вернуться к списку</a>
    </form>
</div>